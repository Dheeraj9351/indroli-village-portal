# ==============================================================================
# ग्राम पंचायत इन्द्रौली (Indroli Village Portal) - Environment Variables Template
# ==============================================================================
# नोट: वास्तविक सीक्रेट्स (Secrets) को कभी भी GitHub में कमिट न करें।
# इन वेरिएबल्स को Vercel Project Settings -> Environment Variables में जोड़ें।
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Supabase Project Dashboard -> Settings -> API से प्राप्त करें:
SUPABASE_URL=https://your-project-id.supabase.co
# Service Role Key (केवल सर्वर-साइड उपयोग के लिए, यह RLS को बायपास करता है):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# Anon Key (वैकल्पिक सार्वजनिक कुंजी):
SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Admin Dashboard Authentication
# ------------------------------------------------------------------------------
# एडमिन डैशबोर्ड को सुरक्षित रखने के लिए मजबूत पासवर्ड सेट करें:
ADMIN_PASSWORD=Indroli@Admin2026
# HMAC सत्र टोकन साइनिंग के लिए सीक्रेट की (कोई भी सुरक्षित यादृच्छिक स्ट्रिंग):
ADMIN_JWT_SECRET=indroli_secure_admin_jwt_secret_change_in_production

# ------------------------------------------------------------------------------
# 3. Meta / WhatsApp Business Platform Cloud API
# ------------------------------------------------------------------------------
# Meta for Developers (developers.facebook.com) -> WhatsApp -> API Setup से:
# System User Access Token (कॉल करने हेतु स्थायी टोकन):
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
# Phone Number ID (Meta Business Phone Number ID):
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# व्यवस्थापक का WhatsApp नंबर (जिस पर सूचनाएं प्राप्त होंगी, देश कोड सहित, उदा. 919829000000):
WHATSAPP_ADMIN_PHONE=919829000000
# (वैकल्पिक) Meta द्वारा स्वीकृत WhatsApp मैसेज टेम्पलेट नाम:
WHATSAPP_TEMPLATE_NAME=indroli_new_complaint
# टेम्पलेट की भाषा (उदा. hi या en_US):
WHATSAPP_TEMPLATE_LANG=hi
